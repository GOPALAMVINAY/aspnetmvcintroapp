
@{
     Layout = null;
}
<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Content/plugins/datepicker/bootstrap-datepicker.js"></script>
<link href="~/Content/plugins/datepicker/datepicker3.css" rel="stylesheet"/>
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Index</title>
</head>
<body>
    <h2 style="text-align:center;">Employee registration</h2>
    <div style="width:300px;float:left;margin-left:350px;">
        <div class="form-group">
            <label for="exampleInputEmployeeName">Employee Name</label>
            <input type="text" class="form-control" id="Txtemployeename" placeholder="Enter Employee Name">
        </div>
        
        <div class="form-group">
            <label>DOJ</label>

            <div style="width:300px;" class="input-group date">
                <div class="input-group-addon">
                    <i class="fa fa-calendar"></i>
                </div>
                <input type="text" class="form-control pull-right" id="datepicker">
            </div>
            <label id="dateValidate" hidden></label>
            <!-- /.input group -->
        </div>
        <br/>
    </div>
    <div float:left;margin-left:50px;">
        <div class="form-group">
            <label>Employment Type</label>
            <select class="form-control" id="ddlemptype">
                <option>---Select Employment Type---</option>
                <option>Permanent 1</option>
                <option>Contract</option>
                <option>Guest</option>
                <option>vendor</option>
                <option>Consultant</option>
            </select>
        </div>
        <br/>
        <div class="form-group">
            <label for="exampleInputMobileNumber">Mobile Number</label>
            <input type="number" class="form-control" id="TxtMobilenumber" placeholder="Enter Mobile Number">
        </div>
        <br/> 
    </div>
</body>
</html>
<div>
    <input type="submit" id="btninsert" class="btn btn-primary" value="Submit" />
</div>
<script type="text/javascript">

    $(function () {
        //Date picker
        $('#datepicker').datepicker({
            autoclose: true
        })
    })
    //form values read and creating json object and send to controller using ajax func call
    // json object recievees class obj in controlelr action method
    //class insid eproperty match with must and should json object keys
    $(document).on("click", "#btninsert", function () {
        var empname = $('#Txtemployeename').val();
        var doj = $('#datepicker').val();
        var empType = $('#ddlemptype').val();
        var mobileNumber = $('#TxtMobilenumber').val();

        var formdata = { ename: empname, dj: doj, etype: empType, mbnumber: mobileNumber }
        $.ajax({
            type: "POST",
            url: "/Emp/Insert",
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(formdata),
            dataType: "json",
            success: function (msg) {
                if (msg == "save") {
                    alert("Data saved successfully");
                     window.location.href = "/Emp/viewempdata";
                }
                else {
                    alert("Some error in code. Please check");
                }
            },
            error: function (req, status, error) {
                alert("Error try again");
            }
        });
    });
</script>